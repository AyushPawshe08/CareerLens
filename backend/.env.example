# ============================================================
# CareerLens — Production Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to git!
# All these secrets must also be added to GitHub Actions
# (Settings → Secrets → Actions).
# ============================================================

# ── Database (Neon PostgreSQL) ────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# ── JWT Auth ──────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
OTP_EXPIRE_MINUTES=10

# ── Email (Gmail SMTP) ────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-gmail@gmail.com

# ── Redis / Celery ────────────────────────────────────────
# Local development: redis://localhost:6379/0
# Docker / production: redis://redis:6379/0   (redis = container name)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── LLM Providers ─────────────────────────────────────────
# Groq (primary for most tasks — fast, cheap)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini (primary for resume scoring/skills — strong reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter (primary for ATS resume rewriting — Qwen long-form generation)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# ── Model Selection ───────────────────────────────────────
# Change these to switch models without touching code.
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=qwen/qwen3-235b-a22b

# ── LLM Router Settings ───────────────────────────────────
# Max per-provider retry attempts for transient errors (429, timeout, etc.)
LLM_MAX_RETRIES=3

# Base delay in seconds for exponential backoff: delay = base * 2^attempt + jitter
LLM_BASE_DELAY=2.0

# ── LLM Response Cache (Redis TTL) ───────────────────────
# Time-to-live in seconds for cached LLM responses. Default: 1 hour.
# Set to 0 to disable caching (not recommended for production).
LLM_CACHE_TTL_SECONDS=3600

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example: http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000
