# ============================================================
# CareerLens — Production Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to git!
# All these secrets must also be added to GitHub Actions
# (Settings → Secrets → Actions).
# ============================================================

# ── Database (Neon PostgreSQL) ────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# ── JWT Auth ──────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
OTP_EXPIRE_MINUTES=10

# ── Email (Gmail SMTP) ────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-gmail@gmail.com

# ── Redis / Celery ────────────────────────────────────────
# Local development: redis://localhost:6379/0
# Docker / production: redis://redis:6379/0   (redis = container name)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Groq LLM API ─────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── CORS (comma-separated list of allowed frontend origins) ─
# Example: http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000
